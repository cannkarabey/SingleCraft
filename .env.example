# Supabase — `npx supabase status -o env` prints local values (API_URL, ANON_KEY, SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inngest — local dev: INNGEST_DEV=1 (talks to `npm run inngest`); production: the two keys, no INNGEST_DEV
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# LLM — provider:model, read by lib/llm/provider.ts (Faz 3)
LLM_STORY_MODEL=            # e.g. google:auto (free-tier fallback chain), google:gemini-flash or anthropic:claude-haiku-5-5
LLM_STUDIO_MODEL=           # e.g. google:auto or anthropic:claude-sonnet-5-5
LLM_EMBED_MODEL=            # google only, 768 dims requested, e.g. google:gemini-embedding-001
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DAILY_BUDGET_USD=1
STORY_BUILD_TOP_N=30
STORY_BUILD_DAILY_LIMIT=40     # max story-builder LLM calls per UTC day
EMBED_MAX_ITEMS_PER_RUN=500    # items embedded per run; Gemini free tier allows 100 texts/min, use 90

# Sources
GITHUB_TOKEN=
PRODUCTHUNT_TOKEN=

# Email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=      # whsec_… (Resend webhook for email.opened)
EMAIL_FROM=

# Billing: Lemon Squeezy (plan §1 #1). Use test-mode keys/variants for sandbox.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=        # webhook signing secret; webhook URL: <app>/api/billing/webhook
LEMONSQUEEZY_CREATOR_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=        # optional until Pro launches

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
# us.i.posthog.com or eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Only for `npm run posthog:dashboard` (personal key, never shipped to the app)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_APP_HOST=https://us.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=     # usually the same DSN
SENTRY_AUTH_TOKEN=          # optional: source map upload (CI)
SENTRY_ORG=
SENTRY_PROJECT=

# Auth: OAuth providers shown on /login (comma list: google,github); configure them in Supabase first
NEXT_PUBLIC_AUTH_PROVIDERS=
# One-click unsubscribe links (HMAC); falls back to SUPABASE_SERVICE_ROLE_KEY when empty
EMAIL_UNSUBSCRIBE_SECRET=
# Local mail without RESEND_API_KEY goes to Supabase Mailpit
MAILPIT_URL=http://127.0.0.1:54324
