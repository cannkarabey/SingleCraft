# Supabase — `npx supabase status -o env` prints local values (API_URL, ANON_KEY, SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inngest — local dev: INNGEST_DEV=1 (talks to `npm run inngest`); production: the two keys, no INNGEST_DEV
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# LLM — provider:model, read by lib/llm/provider.ts (Faz 3)
LLM_STORY_MODEL=            # e.g. google:gemini-flash or anthropic:claude-haiku-5-5
LLM_STUDIO_MODEL=           # e.g. anthropic:claude-sonnet-5-5
LLM_EMBED_MODEL=            # google only, 768 dims requested, e.g. google:gemini-embedding-001
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DAILY_BUDGET_USD=1
STORY_BUILD_TOP_N=30
STORY_BUILD_DAILY_LIMIT=40     # max story-builder LLM calls per UTC day

# Sources
GITHUB_TOKEN=
PRODUCTHUNT_TOKEN=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Billing (decided in Faz 8)
BILLING_PROVIDER=           # paddle | lemonsqueezy | stripe
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# Auth: OAuth providers shown on /login (comma list: google,github); configure them in Supabase first
NEXT_PUBLIC_AUTH_PROVIDERS=
